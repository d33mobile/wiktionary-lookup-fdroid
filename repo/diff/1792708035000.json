{"repo": {"timestamp": 1792786825000}, "packages": {"pl.d33.wiktionary": {"metadata": {"issueTracker": "https://github.com/d33mobile/wiktionary-lookup/issues", "lastUpdated": 1792786820000, "license": "GPL-3.0-or-later AND CC-BY-SA-4.0 AND Arphic-1999", "sourceCode": "https://github.com/d33mobile/wiktionary-lookup", "description": {"en-US": "An offline dictionary built from English Wiktionary. Results update on\nevery keystroke; search by headword, by romanization (pinyin for Chinese,\nwith or without tone digits) or by English words in the definitions. Tap a\nresult to see all of its senses. The speaker button plays the Wiktionary\nrecording when there is one (from Wikimedia Commons, cached on the device)\nand otherwise reads the word with the system text-to-speech voice.\n\nChinese (about 190,000 entries) ships inside the APK and works without\nnetwork access. Every other language that English Wiktionary covers can be\ndownloaded from the language menu; the indexes are hosted as GitHub release\nassets of https://github.com/d33mobile/wiktionary-lookup-data and are kept\non the device after download.\n\nLicensing: the app is free software under the GNU GPL, version 3 or later\n(its lookup engine is MIT licensed); the handwriting recognizer is\nHanziLookupJS (GPL) with stroke data from Make Me a Hanzi under the Arphic\nPublic License. The dictionary data is derived\nfrom Wiktionary and is licensed under CC BY-SA 4.0 (and GFDL); credit goes\nto the Wiktionary contributors (https://en.wiktionary.org/) and to\nwiktextract and kaikki.org (https://kaikki.org/dictionary/)."}}, "versions": {"3cb19800c3fac60d8d5e22ef2811781385ea5da08800637d5c47ee9d7f5b7f06": {"added": 1792786820000, "file": {"name": "/wiktionary-lookup-0.10.apk", "sha256": "3cb19800c3fac60d8d5e22ef2811781385ea5da08800637d5c47ee9d7f5b7f06", "size": 2218694}, "manifest": {"versionName": "0.10", "versionCode": 10, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["ec9a946f10fa1d3b3