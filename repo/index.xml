wiktextract and kaikki.org (https://kaikki.org/dictionary/).</desc><license>MIT AND CC-BY-SA-4.0</license><categories>Reading</categories><category>Reading</category><web>https://d33mobile.github.io/wiktionary-lookup-fdroid/</web><source></source><tracker></tracker><author>d33mobile</author><marketversion></marketversion><marketvercode>5</marketvercode><package><version>0.5</version><versioncode>5</versioncode><apkname>wiktionary-lookup-0.5.apk</apkname><hash type="sha256">1c5cead94aa80be16777d4cb3e512580a994e53fb6c5987f07003432825d3606</hash><size>54080575</size><sdkver>26</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-10-22</added><sig>57beffda747bb9c4c88eea3be91eada7</sig><permissions>ACCESS_NETWORK_STATE,INTERNET</permissions></package><package><version>0.4</version><versioncode>4</versioncode><apkname>wiktionary-lookup-0.4.apk</apkname><hash type="sha256">0b8b00786d0c8067c66b4a2adaa7b0a0b25e3f6e318b495d2c96bd88c050e95a</hash><size>19043189</size><sdkver>26</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-10-22</added><sig>57beffda747bb9c4c88eea3be91eada7</sig><permissions>ACCESS_NETWORK_STATE,INTERNET</permissions></package><package><version>0.3</version><versioncode>3</versioncode><apkname>wiktionary-lookup-0.3.apk</apkname><hash type="sha256">ae9a95b0dab6885cf7de6c2267435ef7c9dafeef7d126fc6b49b5add3bb56ef2</hash><size>18903856</size><sdkver>26</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-10-22</added><sig>57beffda747bb9c4c88eea3be91eada7</sig><permissions>INTERNET</permissions></package><package><version>0.2</version><versioncode>2</versioncode><apkname>wiktionary-lookup-0.2.apk</apkname><hash type="sha256">3dbd223c0a891b519ebcaa4424f81f292b629eb96a07c8993a5ce87d1d57ea1e</hash><size>17461426</size><sdkver>26</sdkver><targetSdkVersion>36</targetSdkVersion><added>2026-10-22</added><sig>57beffda747bb9c4c88eea3be91eada7</sig><permissions>INTERNET</permissions></package><package><version>0.1</version><versioncode>1</versioncode>